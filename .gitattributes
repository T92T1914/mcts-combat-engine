# Rendering receipts identify SVG bytes across operating systems.
docs/mcts-decision-clair.svg text eol=lf
docs/mcts-decision-obscur.svg text eol=lf

# Preserve the first attempt's exact bytes, including recorded line endings.
docs/same-forest-results.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/serial-profile-results.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/same-forest-repeatability-public-receipts.json -text
docs/same-forest-repeatability-public-failed-attempt.json -text

# Wide figure receipts require the same bytes on Windows checkouts.
docs/mcts-decision-clair-wide.svg text eol=lf
docs/mcts-decision-obscur-wide.svg text eol=lf
docs/same-forest-repeatability-*.svg text eol=lf
